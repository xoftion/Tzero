# Django Core Settings
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Media Storage (Cloudinary)
CLOUDINARY_URL=

# Blockchain RPC Endpoints
PI_RPC_URL=
SIDRA_RPC_URL=

# Escrow Contract
ESCROW_CONTRACT_ADDRESS=

# Currency Conversion Rates
# Sidra is fixed at 50 NGN, but can be overridden here.
# Pi is volatile and should be updated by a background task, this is a fallback.
SIDRA_NGN_RATE=50
PI_USD_RATE=0.34
NGN_USD_RATE=0.0007 # Approx 1400 NGN to 1 USD, can be updated via API

# Email (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
